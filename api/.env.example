# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais mis dans git.

# development | test | production
ENVIRONMENT=development

# En local : SQLite. Sur Railway : l'adresse Postgres fournie par Railway (postgresql://...).
DATABASE_URL=sqlite+aiosqlite:///./hq.db

# Secret qui signe les sessions (au moins 32 caractères). Obligatoire en production.
# En local, s'il est vide, une valeur aléatoire est créée à chaque démarrage.
HQ_SESSION_SECRET=

# Identifiant OAuth « Application Web » créé dans la console Google Cloud de Nyuman.
GOOGLE_CLIENT_ID=

# Connexion par lien envoyé par email, depuis une boîte @nyuman.app (chez Netim).
# Le mot de passe de la boîte est entré par l'équipe ici, sur le serveur seulement.
# Sur un PC, si SMTP_HOST est vide : le lien s'affiche dans le journal du serveur au lieu d'être envoyé.
SMTP_HOST=
# 465 = SSL (le plus courant chez Netim), 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Adresse d'expédition (par défaut : SMTP_USER)
SMTP_FROM=
# Adresse publique de HQ : les liens envoyés y mènent.
HQ_PUBLIC_URL=http://localhost:5173

# Connexion sans Google, pour le développement sur un PC seulement. Refusée en production.
HQ_DEV_LOGIN=true

# Adresses des premiers heads, séparées par des virgules. Ils pourront ensuite ajouter les autres.
HQ_HEADS_INITIAUX=

# Adresses autorisées à appeler l'API depuis un navigateur.
HQ_ORIGINES=http://localhost:5173,http://127.0.0.1:5173

# Chiffres de l'app : compte Postgres en lecture seule sur la base Nyuman (staging d'abord).
# Marche à suivre : docs/lecture-base-nyuman.md
NYUMAN_DB_LECTURE_URL=

# Autre possibilité (mise de côté) : la route statistiques de nyuman-api et sa clé.
NYUMAN_API_URL=
NYUMAN_STATS_KEY=
