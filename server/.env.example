# Copier en .env et remplir. Ne jamais commiter .env.
HQ_DATABASE_URL=postgresql+asyncpg://localhost/nyuman_hq
# Une longue phrase aléatoire, choisie par Kevin ou Mohamed.
HQ_SESSION_SECRET=
# true en local seulement : choisir son profil sans mot de passe.
HQ_DEV_LOGIN=true
HQ_CORS_ORIGINS=http://localhost:5180
# Plus tard (réunions Google Meet) : identifiants Google, remplis par Kevin.
# HQ_GOOGLE_CLIENT_ID=
# HQ_GOOGLE_CLIENT_SECRET=
# HQ_GOOGLE_REFRESH_TOKEN=
# Visio de secours, sans compte :
# HQ_JITSI_BASE=https://meet.jit.si

# Réveil automatique des agents (Claude lancé en arrière-plan quand on leur écrit).
# Nécessite que le Mac soit connecté à Claude en ligne de commande (`claude` puis /login, fait par Mohamed).
HQ_AGENT_WAKE=true
HQ_AGENT_DAILY_CAP=30
HQ_AGENT_MAX_BUDGET_USD=0.25
# Chiffres de l'app dans « Mon espace » (totaux seulement, aucune donnée personnelle).
# L'adresse de la route de nyuman-api et la même clé que HQ_STATS_KEY côté API, posées par Kevin.
# HQ_STATS_URL=https://<adresse de l'API>/admin/hq-stats
# HQ_STATS_KEY=

# ----- Mise en ligne (rempli par Kevin, jamais lu par Kwame) -----
# Adresse publique de HQ, sans / final.
# HQ_PUBLIC_URL=https://hq.nyuman.app
# Connexion Google (projet Google Cloud, identifiant « Application Web »).
# Adresse de retour à déclarer chez Google : https://hq.nyuman.app/api/auth/google/callback
# HQ_GOOGLE_CLIENT_ID=
# HQ_GOOGLE_CLIENT_SECRET=
# Mot de passe de la base, choisi au hasard (sert à docker-compose).
# HQ_DB_PASSWORD=
