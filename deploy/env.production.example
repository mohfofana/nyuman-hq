# Réglages de Nyuman HQ en production. Copier en deploy/.env sur le serveur, puis remplir.
# Ce fichier .env n'est jamais mis dans git. Les mots de passe sont entrés par l'équipe, ici seulement.

ENVIRONMENT=production

# Adresse publique de HQ (les liens envoyés par email y mènent) et origine autorisée à écrire.
HQ_PUBLIC_URL=https://hq.nyuman.com
HQ_ORIGINES=https://hq.nyuman.com

# Mot de passe de la base de HQ (une base à part, pas celle de l'app). Long et aléatoire, en hexadécimal (il entre dans une adresse) :  openssl rand -hex 32
HQ_POSTGRES_PASSWORD=

# Secret qui signe les sessions, 32 caractères au moins :  openssl rand -hex 32
HQ_SESSION_SECRET=

# Port de HQ sur le serveur, lu par Nginx (8000 et 8001 sont pris par nyuman-api prod et staging).
HQ_PORT=8002

# Premiers heads (ils ajoutent ensuite les autres dans Réglages).
HQ_HEADS_INITIAUX=mohamed.fofana@nyuman.app

# Connexion par lien envoyé par email : la boîte d'envoi @nyuman.app créée chez Netim.
# Réglages SMTP donnés par Netim pour cette boîte (serveur, port 465 en SSL).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Connexion de développement : toujours fausse ici (HQ refuse de démarrer sinon).
HQ_DEV_LOGIN=false

# Facultatif : bouton « Se connecter avec Google » (identifiant OAuth de Nyuman).
GOOGLE_CLIENT_ID=

# Chiffres de l'app : compte Postgres en lecture seule sur la base Nyuman (staging d'abord).
# Marche à suivre : docs/lecture-base-nyuman.md. Depuis le conteneur, le serveur s'appelle host.docker.internal.
# Exemple : postgresql://hq_lecture:MOT_DE_PASSE@host.docker.internal:5432/nyuman_db
NYUMAN_DB_LECTURE_URL=
